{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadanomaly.local/schemas/audit-summary-1.0.json",
  "title": "RoadAnomaly dataset audit summary",
  "description": "Single authoritative schema for the MVP RoadAnomaly benchmark audit. The JSON summary is the evidence source; the Markdown report is rendered from validated bytes. Overlays, figures, the review ledger and normal-road readiness are post-MVP extensions and are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "fingerprint",
    "inventory",
    "instance_semantic",
    "coverage",
    "categories",
    "object_scale",
    "instance_mapping",
    "roi",
    "duplicates",
    "credits",
    "provenance",
    "documented_claims",
    "limitations",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "instance_semantic": {
      "$ref": "#/$defs/instanceSemantic"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "categories": {
      "$ref": "#/$defs/categories"
    },
    "object_scale": {
      "$ref": "#/$defs/scale"
    },
    "instance_mapping": {
      "$ref": "#/$defs/mapping"
    },
    "roi": {
      "$ref": "#/$defs/roi"
    },
    "duplicates": {
      "$ref": "#/$defs/duplicates"
    },
    "credits": {
      "$ref": "#/$defs/credits"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "documented_claims": {
      "$ref": "#/$defs/documentedClaims"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    },
    "claims": {
      "$ref": "#/$defs/claims"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "frameName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.webp$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "python",
        "numpy",
        "pillow",
        "jsonschema",
        "command",
        "audit_version"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "numpy": {
          "type": "string",
          "minLength": 1
        },
        "pillow": {
          "type": "string",
          "minLength": 1
        },
        "jsonschema": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "const": "make data-audit"
        },
        "audit_version": {
          "const": "1.0"
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical",
        "recipe",
        "recipe_version",
        "provenance",
        "computed",
        "matches",
        "historical_file_count",
        "historical_total_bytes",
        "current_file_count",
        "current_total_bytes",
        "status"
      ],
      "properties": {
        "historical": {
          "const": "7c16ab39607d68a66bc2f4ac321933f64221d62980119ea780af5abf2a99f4e2"
        },
        "recipe": {
          "const": "regular files under data/ (no symlinks), sorted by POSIX relative path; for each: UTF-8 path + NUL + raw 32-byte SHA-256 of content; no trailing NUL/newline; lowercase hex"
        },
        "recipe_version": {
          "const": "historical-v1"
        },
        "provenance": {
          "const": "local_reconstruction"
        },
        "computed": {
          "$ref": "#/$defs/sha256"
        },
        "matches": {
          "const": true
        },
        "historical_file_count": {
          "const": 677
        },
        "historical_total_bytes": {
          "const": 13135474
        },
        "current_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "current_total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "const": "match"
        }
      }
    },
    "frameRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_name",
        "frame_path",
        "width",
        "height",
        "mode",
        "frame_sha256",
        "label_dir",
        "annotation_kind"
      ],
      "properties": {
        "frame_name": {
          "$ref": "#/$defs/frameName"
        },
        "frame_path": {
          "type": "string",
          "pattern": "^frames/[A-Za-z0-9_.-]+\\.webp$"
        },
        "width": {
          "const": 1280
        },
        "height": {
          "const": 720
        },
        "mode": {
          "const": "RGB"
        },
        "frame_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "label_dir": {
          "type": "string",
          "pattern": "^frames/[A-Za-z0-9_.-]+\\.labels$"
        },
        "annotation_kind": {
          "enum": [
            "instance",
            "semantic_only"
          ]
        }
      }
    },
    "annotationIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_values",
        "colour_mapping",
        "colour_mapping_valid",
        "instance_class_id",
        "instance_ids_contiguous",
        "label_files_complete",
        "frame_decodable"
      ],
      "properties": {
        "semantic_values": {
          "const": [
            0,
            2
          ]
        },
        "colour_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normal",
            "anomaly"
          ],
          "properties": {
            "normal": {
              "const": [
                0,
                0,
                0
              ]
            },
            "anomaly": {
              "const": [
                255,
                69,
                0
              ]
            }
          }
        },
        "colour_mapping_valid": {
          "const": true
        },
        "instance_class_id": {
          "const": 2
        },
        "instance_ids_contiguous": {
          "const": true
        },
        "label_files_complete": {
          "const": true
        },
        "frame_decodable": {
          "const": true
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_list_count",
        "frame_count",
        "label_dir_count",
        "instance_frame_count",
        "semantic_only_frame_count",
        "annotation_integrity",
        "frames"
      ],
      "properties": {
        "frame_list_count": {
          "const": 60
        },
        "frame_count": {
          "const": 60
        },
        "label_dir_count": {
          "const": 60
        },
        "instance_frame_count": {
          "const": 46
        },
        "semantic_only_frame_count": {
          "const": 14
        },
        "annotation_integrity": {
          "$ref": "#/$defs/annotationIntegrity"
        },
        "frames": {
          "type": "array",
          "minItems": 60,
          "maxItems": 60,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/frameRecord"
          }
        }
      }
    },
    "instanceSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frames_checked",
        "frames_exact_match",
        "frames_mismatched",
        "mismatched_frames",
        "extra_instance_pixels",
        "missing_instance_pixels",
        "semantic_only_frames_excluded",
        "definition"
      ],
      "properties": {
        "frames_checked": {
          "const": 46
        },
        "frames_exact_match": {
          "const": 46
        },
        "frames_mismatched": {
          "const": 0
        },
        "mismatched_frames": {
          "type": "array",
          "maxItems": 0
        },
        "extra_instance_pixels": {
          "const": 0
        },
        "missing_instance_pixels": {
          "const": 0
        },
        "semantic_only_frames_excluded": {
          "const": 14
        },
        "definition": {
          "const": "union(instance values 1..N) == semantic value 2, per instance frame"
        }
      }
    },
    "frameCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_name",
        "anomaly_pixels",
        "total_pixels",
        "fraction",
        "percent"
      ],
      "properties": {
        "frame_name": {
          "$ref": "#/$defs/frameName"
        },
        "anomaly_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "total_pixels": {
          "const": 921600
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "coverageDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pooled_fraction",
        "per_frame_fraction",
        "percent",
        "median",
        "below_one_percent"
      ],
      "properties": {
        "pooled_fraction": {
          "const": "total anomaly pixels / total pixels over all 60 frames"
        },
        "per_frame_fraction": {
          "const": "anomaly pixels / (1280 x 720)"
        },
        "percent": {
          "const": "100 x fraction"
        },
        "median": {
          "const": "median of the 60 per-frame fractions"
        },
        "below_one_percent": {
          "const": "per-frame percent < 1.0"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_anomaly_pixels",
        "total_pixels",
        "pooled_fraction",
        "pooled_percent",
        "minimum_percent",
        "maximum_percent",
        "median_percent",
        "below_one_percent",
        "per_frame",
        "definitions"
      ],
      "properties": {
        "total_anomaly_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "total_pixels": {
          "const": 55296000
        },
        "pooled_fraction": {
          "const": 0.09849561
        },
        "pooled_percent": {
          "const": 9.849561
        },
        "minimum_percent": {
          "const": 0.374674
        },
        "maximum_percent": {
          "const": 42.328559
        },
        "median_percent": {
          "const": 6.622938
        },
        "below_one_percent": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/frameName"
          }
        },
        "per_frame": {
          "type": "array",
          "minItems": 60,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/frameCoverage"
          }
        },
        "definitions": {
          "$ref": "#/$defs/coverageDefinitions"
        }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "total_frames",
        "classification"
      ],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "animals",
            "obstacles",
            "cones",
            "lost_tires",
            "vehicle"
          ],
          "properties": {
            "animals": {
              "type": "integer",
              "minimum": 0
            },
            "obstacles": {
              "type": "integer",
              "minimum": 0
            },
            "cones": {
              "type": "integer",
              "minimum": 0
            },
            "lost_tires": {
              "type": "integer",
              "minimum": 0
            },
            "vehicle": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "total_frames": {
          "const": 60
        },
        "classification": {
          "const": "object_category_not_scene"
        }
      }
    },
    "scaleDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roi_area",
        "both_dimensions_below_32",
        "either_dimension_below_32",
        "roi_equivalent_square",
        "roi_bounding_box",
        "mask_equivalent_square"
      ],
      "properties": {
        "roi_area": {
          "const": "(x1 - x0) x (y1 - y0), half-open extents"
        },
        "both_dimensions_below_32": {
          "const": "width < 32 and height < 32"
        },
        "either_dimension_below_32": {
          "const": "width < 32 or height < 32"
        },
        "roi_equivalent_square": {
          "const": "sqrt(ROI area)"
        },
        "roi_bounding_box": {
          "const": "median ROI width and height"
        },
        "mask_equivalent_square": {
          "const": "sqrt(count of nonzero instance-mask pixels)"
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roi_area_below_1024",
        "both_dimensions_below_32",
        "either_dimension_below_32",
        "median_roi_equivalent_square_px",
        "median_roi_width_px",
        "median_roi_height_px",
        "median_mask_equivalent_square_px",
        "denominator",
        "definitions"
      ],
      "properties": {
        "roi_area_below_1024": {
          "const": 35
        },
        "both_dimensions_below_32": {
          "const": 20
        },
        "either_dimension_below_32": {
          "const": 46
        },
        "median_roi_equivalent_square_px": {
          "const": 86.7
        },
        "median_roi_width_px": {
          "const": 85.0
        },
        "median_roi_height_px": {
          "const": 107.0
        },
        "median_mask_equivalent_square_px": {
          "const": 51.2
        },
        "denominator": {
          "const": 201
        },
        "definitions": {
          "$ref": "#/$defs/scaleDefinitions"
        }
      }
    },
    "mappingMismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_name",
        "mask_value",
        "index_position",
        "index_id"
      ],
      "properties": {
        "frame_name": {
          "$ref": "#/$defs/frameName"
        },
        "mask_value": {
          "type": "integer",
          "minimum": 1
        },
        "index_position": {
          "type": "integer",
          "minimum": 1
        },
        "index_id": {
          "type": "integer"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frames_checked",
        "frames_agreeing",
        "frames_disagreeing",
        "disagreeing_frames",
        "mismatches",
        "existing_test_check"
      ],
      "properties": {
        "frames_checked": {
          "const": 46
        },
        "frames_agreeing": {
          "const": 35
        },
        "frames_disagreeing": {
          "const": 11
        },
        "disagreeing_frames": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/frameName"
          }
        },
        "mismatches": {
          "type": "array",
          "minItems": 11,
          "items": {
            "$ref": "#/$defs/mappingMismatch"
          }
        },
        "existing_test_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "passes"
          ],
          "properties": {
            "name": {
              "const": "max(mask) == len(instances)"
            },
            "passes": {
              "const": true
            }
          }
        }
      }
    },
    "affectedInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_name",
        "mask_value"
      ],
      "properties": {
        "frame_name": {
          "$ref": "#/$defs/frameName"
        },
        "mask_value": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "roiDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "out_of_bounds",
        "non_tight",
        "centroid_containment"
      ],
      "properties": {
        "out_of_bounds": {
          "const": "x0 < 0 or y0 < 0 or x1 > 1280 or y1 > 720, half-open extents"
        },
        "non_tight": {
          "const": "pixel box not strictly inside half-open ROI: bx0 < x0 or by0 < y0 or bx1 >= x1 or by1 >= y1"
        },
        "centroid_containment": {
          "const": "0 <= (bx0 + bx1) / 2 < 1280 and 0 <= (by0 + by1) / 2 < 720"
        }
      }
    },
    "roi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instances_checked",
        "out_of_bounds",
        "non_tight",
        "centroids_inside",
        "out_of_bounds_instances",
        "non_tight_instances",
        "definitions"
      ],
      "properties": {
        "instances_checked": {
          "const": 201
        },
        "out_of_bounds": {
          "const": 11
        },
        "non_tight": {
          "const": 17
        },
        "centroids_inside": {
          "const": 201
        },
        "out_of_bounds_instances": {
          "type": "array",
          "minItems": 11,
          "items": {
            "$ref": "#/$defs/affectedInstance"
          }
        },
        "non_tight_instances": {
          "type": "array",
          "minItems": 17,
          "items": {
            "$ref": "#/$defs/affectedInstance"
          }
        },
        "definitions": {
          "$ref": "#/$defs/roiDefinitions"
        }
      }
    },
    "framePair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_a",
        "frame_b"
      ],
      "properties": {
        "frame_a": {
          "$ref": "#/$defs/frameName"
        },
        "frame_b": {
          "$ref": "#/$defs/frameName"
        }
      }
    },
    "dhashPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_a",
        "frame_b",
        "distance"
      ],
      "properties": {
        "frame_a": {
          "$ref": "#/$defs/frameName"
        },
        "frame_b": {
          "$ref": "#/$defs/frameName"
        },
        "distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "duplicates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_pairs",
        "decoded_pairs",
        "dhash_pairs",
        "dhash_method",
        "limitations"
      ],
      "properties": {
        "exact_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/framePair"
          }
        },
        "decoded_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/framePair"
          }
        },
        "dhash_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dhashPair"
          }
        },
        "dhash_method": {
          "const": "9x8 grayscale dHash, 64 bits; Hamming distance <= 6"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "creditEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_name",
        "credit_text",
        "licence_tokens",
        "source_url",
        "attribution"
      ],
      "properties": {
        "frame_name": {
          "$ref": "#/$defs/frameName"
        },
        "credit_text": {
          "type": "string",
          "minLength": 1
        },
        "licence_tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "source_url",
        "frames",
        "frame_count"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frameName"
          }
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "coverage",
        "missing_entries",
        "missing_licence_tokens",
        "missing_source_urls",
        "source_groups",
        "annotation_licence_claim",
        "annotation_licence_sources",
        "annotation_licence_terms_url",
        "code_licence",
        "code_licence_source",
        "code_licence_scope",
        "legal_conclusion"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 60,
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/creditEntry"
          }
        },
        "coverage": {
          "const": 60
        },
        "missing_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frameName"
          }
        },
        "missing_licence_tokens": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/frameName"
          }
        },
        "missing_source_urls": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/frameName"
          }
        },
        "source_groups": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/sourceGroup"
          }
        },
        "annotation_licence_claim": {
          "const": "CC BY-SA 4.0"
        },
        "annotation_licence_sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
