    "def reconstruction_error_maps(model, images):\n",
    "    \"\"\"Reconstruct full images; return (reconstructions, per-pixel squared error averaged over RGB).\"\"\"\n",
    "    reconstructions = model.predict(images, batch_size=4, verbose=0)\n",
    "    return reconstructions, ((images - reconstructions) ** 2).mean(axis=-1)\n",
    "\n",
    "def smooth(error_maps, sigma):\n",
    "    \"\"\"Gaussian smoothing of each error map (sigma = 0 means no smoothing).\"\"\"\n",
    "    if sigma == 0:\n",
    "        return error_maps\n",
    "    return np.stack([ndimage.gaussian_filter(m, sigma) for m in error_maps])\n",
    "\n",
    "def standardise_per_image(maps):\n",
    "    \"\"\"z-score of each map: how unusual a pixel is compared with the rest of its own image.\"\"\"\n",
    "    return np.stack([(m - m.mean()) / m.std() for m in maps])\n",
    "\n",
    "def anomaly_scores(error_maps, sigma):\n",
    "    \"\"\"Full post-processing: smoothing, then per-image standardisation.\"\"\"\n",
    "    return standardise_per_image(smooth(error_maps, sigma))\n",
    "\n",
    "recon_val, err_val = reconstruction_error_maps(autoencoder, x_val)\n",
    "print(\"reconstructions:\", recon_val.shape, \"| error maps:\", err_val.shape)"
   ]
  },
