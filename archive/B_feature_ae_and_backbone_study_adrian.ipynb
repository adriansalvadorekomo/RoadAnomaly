    "# Faithfulness sanity check: perturb high-attribution pixels and track the fixed scalar target.\n",
    "def validation_region_error(image, region):\n",
    "    image_tensor = tf.convert_to_tensor(image[None, ...], dtype=tf.float32)\n",
    "    _, reconstruction = xai_model(image_tensor, training=False)\n",
    "    error = tf.reduce_mean(tf.square(image_tensor - reconstruction), axis=-1)[0]\n",
    "    region_tensor = tf.convert_to_tensor(region, dtype=tf.float32)\n",
    "    return float(tf.math.divide_no_nan(tf.reduce_sum(error * region_tensor), tf.reduce_sum(region_tensor)))\n",
    "\n",
    "fractions = np.linspace(0.0, 1.0, 6)\n",
    "coordinates = np.argwhere(xai_region)\n",
    "ranked_coordinates = coordinates[np.argsort(xai_heatmap[xai_region])[::-1]]\n",
    "neutral_pixel = xai_image.mean(axis=(0, 1))\n",
    "delete_scores, insert_scores = [], []\n",
    "for fraction in fractions:\n",
    "    count = int(round(fraction * len(ranked_coordinates)))\n",
    "    selected = ranked_coordinates[:count]\n",
    "    deleted = xai_image.copy()\n",
    "    inserted = np.broadcast_to(neutral_pixel, xai_image.shape).copy()\n",
    "    if count:\n",
    "        deleted[selected[:, 0], selected[:, 1]] = neutral_pixel\n",
    "        inserted[selected[:, 0], selected[:, 1]] = xai_image[selected[:, 0], selected[:, 1]]\n",
    "    delete_scores.append(validation_region_error(deleted, xai_region))\n",
    "    insert_scores.append(validation_region_error(inserted, xai_region))\n",
    "\n",
    "plt.figure(figsize=(6, 4))\n",
    "plt.plot(fractions, delete_scores, marker=\"o\", label=\"Deletion: top-attribution pixels replaced\")\n",
    "plt.plot(fractions, insert_scores, marker=\"o\", label=\"Insertion: top-attribution pixels restored\")\n",
    "plt.xlabel(\"Fraction of target-region pixels perturbed\")\n",
    "plt.ylabel(\"Mean raw reconstruction error in fixed region\")\n",
    "plt.title(\"Validation-only attribution sanity check\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIG_DIR / \"B_04_validation_xai_perturbation.png\", dpi=100, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "print(\"Interpret curves descriptively only; they are not a causal explanation or a pass/fail test.\")\n"
   ]
  },
