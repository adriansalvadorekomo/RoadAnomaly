    "def get_feature_model(channels, hidden=FEATURE_HIDDEN, code_channels=FEATURE_CODE_CHANNELS):\n",
    "    \"\"\"Autoencoder on feature maps: 3x3 conv -> narrow linear 1x1 code -> 3x3 conv -> linear 1x1 output.\"\"\"\n",
    "    inputs = keras.Input(shape=(None, None, channels))\n",
    "    x = layers.Conv2D(hidden, 3, padding=\"same\", activation=\"relu\")(inputs)       # encoder\n",
    "    code = layers.Conv2D(code_channels, 1, activation=None, name=\"code\")(x)       # bottleneck (linear)\n",
    "    x = layers.Conv2D(hidden, 3, padding=\"same\", activation=\"relu\")(code)         # decoder\n",
    "    outputs = layers.Conv2D(channels, 1, activation=None)(x)                      # standardised features\n",
    "    return keras.Model(inputs, outputs, name=\"feature_autoencoder\")\n",
    "\n",
    "def train_feature_ae(data, seed):\n",
    "    \"\"\"Train one feature AE on the normal cells only (anomaly cells have weight 0 in the loss).\"\"\"\n",
    "    keras.utils.set_random_seed(seed)\n",
    "    model = get_feature_model(data[\"train\"].shape[-1])\n",
    "    model.compile(optimizer=keras.optimizers.Adam(LEARNING_RATE), loss=\"mse\")\n",
    "    early_stopping = keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=FEATURE_PATIENCE,\n",
    "                                                   restore_best_weights=True)\n",
    "    history = model.fit(data[\"train\"], data[\"train\"], sample_weight=data[\"ok_train\"].astype(\"float32\"),\n",
    "                        validation_data=(data[\"val\"], data[\"val\"], data[\"ok_val\"].astype(\"float32\")),\n",
    "                        epochs=FEATURE_EPOCHS, batch_size=FEATURE_BATCH_SIZE,\n",
    "                        callbacks=[early_stopping], verbose=0)\n",
    "    return model, history\n",
    "\n",
    "def feature_error_maps(model, features):\n",
    "    \"\"\"Squared reconstruction error of each cell (mean over channels), upsampled to IMG_SIZE.\"\"\"\n",
    "    reconstructions = model.predict(features, batch_size=FEATURE_BATCH_SIZE, verbose=0)\n",
    "    return upsample(((features - reconstructions) ** 2).mean(axis=-1))\n",
    "\n",
    "get_feature_model(512).summary()"
   ]
  },
