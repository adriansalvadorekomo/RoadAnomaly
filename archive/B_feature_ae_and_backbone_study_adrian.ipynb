    "# Frozen VGG16 pretrained on ImageNet: a fixed feature extractor, never trained\n",
    "vgg = keras.applications.VGG16(include_top=False, weights=\"imagenet\")\n",
    "vgg.trainable = False\n",
    "\n",
    "# One extractor per depth, built once (building a new model at every call makes TensorFlow re-trace it)\n",
    "extractors = {layer: keras.Model(vgg.input, vgg.get_layer(layer).output) for layer in FEATURE_LAYERS}\n",
    "\n",
    "def vgg_features(images, layer):\n",
    "    \"\"\"VGG16 activations of `layer` for images in [0, 1].\n",
    "\n",
    "    VGG expects 0-255 RGB images centred with its own `preprocess_input` (not our [0, 1] scaling).\n",
    "    \"\"\"\n",
    "    return extractors[layer].predict(keras.applications.vgg16.preprocess_input(images * 255.0),\n",
    "                                     batch_size=2, verbose=0)\n",
    "\n",
    "def upsample(cell_maps):\n",
    "    \"\"\"Bilinear resize of (N, h, w) maps of feature cells back to the working resolution IMG_SIZE.\"\"\"\n",
    "    return tf.image.resize(cell_maps[..., None], IMG_SIZE, method=\"bilinear\").numpy()[..., 0]\n",
    "\n",
    "# Check: the extractor is deterministic and its output size matches the stride of each block\n",
    "for layer in FEATURE_LAYERS:\n",
    "    f1, f2 = vgg_features(x_val[:1], layer), vgg_features(x_val[:1], layer)\n",
    "    print(f\"{layer}: features {f1.shape} | 1 cell = {IMG_SIZE[0] // f1.shape[1]} px | \"\n",
    "          f\"max difference between two runs = {np.abs(f1 - f2).max()}\")"
   ]
  },
