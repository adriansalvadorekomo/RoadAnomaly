    "def get_model(filters=ENCODER_FILTERS, code_channels=CODE_CHANNELS, channels=3):\n",
    "    \"\"\"Convolutional autoencoder: stride-2 conv blocks down, a narrow code, mirrored transposed blocks up.\"\"\"\n",
    "    inputs = keras.Input(shape=(None, None, channels))   # any size divisible by 2 ** len(filters)\n",
    "\n",
    "    # Encoder: each stride-2 convolution halves height and width (64 -> 32 -> 16 -> 8 -> 4)\n",
    "    x = inputs\n",
    "    for n_filters in filters:\n",
    "        x = layers.Conv2D(n_filters, 3, strides=2, padding=\"same\", activation=\"relu\")(x)\n",
    "\n",
    "    # Bottleneck (the code): very few channels force a strongly compressed representation.\n",
    "    # Linear on purpose: with only 2 channels, a ReLU unit that \"dies\" (always 0) would\n",
    "    # delete half of the code (dying ReLU, DL notes Cap. 4.3.1; see the seed check in 3.1)\n",
    "    code = layers.Conv2D(code_channels, 3, padding=\"same\", activation=None, name=\"code\")(x)\n",
    "\n",
    "    # Decoder: mirror of the encoder, each transposed convolution doubles the size back\n",
    "    x = code\n",
    "    for n_filters in reversed(filters):\n",
    "        x = layers.Conv2DTranspose(n_filters, 3, strides=2, padding=\"same\", activation=\"relu\")(x)\n",
    "    outputs = layers.Conv2D(channels, 3, padding=\"same\", activation=\"sigmoid\")(x)   # pixels in [0, 1]\n",
    "\n",
    "    return keras.Model(inputs, outputs, name=\"conv_autoencoder\")\n",
    "\n",
    "autoencoder = get_model()\n",
    "autoencoder.summary()"
   ]
  },
