    "def extract_normal_patches(images, masks, patch=PATCH, stride=STRIDE, margin=MASK_MARGIN):\n",
    "    \"\"\"Cut images into overlapping patches and keep those with no anomaly pixel.\n",
    "\n",
    "    The anomaly mask is dilated by `margin` px first, so that patches touching the\n",
    "    (loosely annotated) border of an obstacle are discarded too.\n",
    "    \"\"\"\n",
    "    normal, total = [], 0\n",
    "    for image, mask in zip(images, masks):\n",
    "        unsafe = ndimage.binary_dilation(mask[..., 0] > 0, iterations=margin)\n",
    "        for y in range(0, image.shape[0] - patch + 1, stride):\n",
    "            for x in range(0, image.shape[1] - patch + 1, stride):\n",
    "                total += 1\n",
    "                if not unsafe[y:y + patch, x:x + patch].any():\n",
    "                    normal.append(image[y:y + patch, x:x + patch])\n",
    "    return np.stack(normal), total\n",
    "\n",
    "# Normal patches for training and for early stopping\n",
    "p_train, n_train_candidates = extract_normal_patches(x_train, y_train)\n",
    "p_val, n_val_candidates = extract_normal_patches(x_val, y_val)\n",
    "print(f\"train: kept {len(p_train)} normal patches of {n_train_candidates} -> {p_train.shape}\")\n",
    "print(f\"val  : kept {len(p_val)} normal patches of {n_val_candidates} -> {p_val.shape}\")"
   ]
  },
