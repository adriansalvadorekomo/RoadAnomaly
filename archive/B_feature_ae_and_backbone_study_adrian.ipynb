    "order = np.argsort([-s[\"f1\"] for s in test_report_v2[\"pixel\"][\"per_image\"]])\n",
    "fig, ax = plt.subplots(len(order), 5, figsize=(22, 2.6 * len(order)), tight_layout=True)\n",
    "for row, i in enumerate(order):\n",
    "    pred = test_report_v2[\"masks\"][i].astype(bool)\n",
    "    errors = np.zeros(gt_test[i].shape + (3,))\n",
    "    errors[pred & gt_test[i]] = (1, 1, 1)      # true positives: white\n",
    "    errors[pred & ~gt_test[i]] = (1, 0, 0)     # false positives: red\n",
    "    errors[~pred & gt_test[i]] = (0, 0.4, 1)   # false negatives: blue\n",
    "    panels = [(x_test[i], test_frames[i][:30]), (gt_test[i], \"ground truth\"),\n",
    "              (score_test[i], \"v1 score (pixel AE)\"), (score_test_v2[i], \"v2 score (feature AE)\"),\n",
    "              (errors, f\"v2: TP white, FP red, FN blue | F1 {test_report_v2['pixel']['per_image'][i]['f1']:.2f}\")]\n",
