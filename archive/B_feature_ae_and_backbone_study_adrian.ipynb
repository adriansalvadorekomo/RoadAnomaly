    "def prepare_backbone_features(name):\n",
    "    \"\"\"Standardised train / val features of one backbone, with their normal-cell masks (same steps as 12.3).\"\"\"\n",
    "    f_train, f_val = backbone_features(x_train, name), backbone_features(x_val, name)\n",
    "    ok_train, ok_val = normal_cells(y_train, f_train.shape[1:3]), normal_cells(y_val, f_val.shape[1:3])\n",
    "    mean, std = f_train[ok_train].mean(axis=0), f_train[ok_train].std(axis=0) + 1e-6\n",
    "    return {\"train\": standardise_features(f_train, mean, std), \"val\": standardise_features(f_val, mean, std),\n",
    "            \"ok_train\": ok_train, \"ok_val\": ok_val, \"mean\": mean, \"std\": std}\n",
    "\n",
    "def fit_gaussian(data):\n",
    "    \"\"\"One Gaussian (mean + Ledoit-Wolf shrunk covariance) over all the TRAIN normal cells.\"\"\"\n",
    "    return LedoitWolf().fit(data[\"train\"][data[\"ok_train\"]])\n",
    "\n",
    "def mahalanobis_maps(gaussian, features):\n",
    "    \"\"\"Squared Mahalanobis distance of every cell to the normal Gaussian, upsampled to IMG_SIZE.\"\"\"\n",
    "    n, h, w, c = features.shape\n",
    "    return upsample(gaussian.mahalanobis(features.reshape(-1, c)).reshape(n, h, w))\n",
    "\n",
    "# Sanity checks on VGG16: the covariance is invertible, and the mean itself is at distance 0\n",
    "check_data = prepare_backbone_features(\"VGG16\")\n",
    "check_gaussian = fit_gaussian(check_data)\n",
    "print(f\"normal train cells: {check_data['ok_train'].sum()} | shrinkage: {check_gaussian.shrinkage_:.3f} | \"\n",
    "      f\"smallest covariance eigenvalue: {np.linalg.eigvalsh(check_gaussian.covariance_).min():.4f} (> 0)\")\n",
    "print(\"Mahalanobis distance of the mean:\", float(check_gaussian.mahalanobis(check_gaussian.location_[None])[0]))\n",
    "del check_data, check_gaussian"
   ]
  },
