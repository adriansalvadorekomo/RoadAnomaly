    "            f\"AUPRO@{FPR_LIMIT}\": metrics.aupro(list(gt), list(scores), MIN_OBJECT_PX, fpr_limit=FPR_LIMIT),\n",
    "            \"AUPRO chance\": FPR_LIMIT / 2}\n",
    "\n",
