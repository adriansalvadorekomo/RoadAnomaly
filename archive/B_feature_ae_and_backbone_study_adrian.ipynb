    "def full_report(gt, scores, threshold, min_blob=MIN_OBJECT_PX):\n",
    "    \"\"\"All protocol metrics for one split: pixel (per image + aggregated), objects, size, confusion.\"\"\"\n",
    "    masks = to_masks(scores, threshold, min_blob)\n",
    "    pix = metrics.evaluate_masks(list(gt), list(masks))\n",
    "    obj = pd.DataFrame([metrics.object_scores(g, m, MIN_OBJECT_PX) for g, m in zip(gt, masks)])\n",
    "    size = pd.DataFrame([metrics.object_recall_by_size(g, m, MIN_OBJECT_PX, SMALL_OBJECT_PX) for g, m in zip(gt, masks)]).sum()\n",
    "    tp, fp, fn, tn = metrics.confusion_counts(gt, masks)\n",
    "    return {\"masks\": masks, \"pixel\": pix, \"objects\": obj, \"size\": size, \"confusion\": (tp, fp, fn, tn)}\n",
    "\n",
    "def print_report(report):\n",
    "    \"\"\"Readable summary of full_report().\"\"\"\n",
    "    print(\"Pixel metrics, per-image mean :\", {k: round(v, 4) for k, v in report[\"pixel\"][\"per_image_mean\"].items()})\n",
    "    print(\"Pixel metrics, aggregated     :\", {k: round(v, 4) for k, v in report[\"pixel\"][\"aggregated\"].items()})\n",
    "    o = report[\"objects\"]\n",
    "    print(f\"Objects: recall {o['detected'].sum()}/{o['gt_objects'].sum()} = {o['detected'].sum() / o['gt_objects'].sum():.3f} | \"\n",
    "          f\"false alarms {o['false_alarms'].sum()} of {o['pred_objects'].sum()} predicted blobs | \"\n",
    "          f\"mean object F1 per image {o['object_f1'].mean():.3f}\")\n",
    "    s = report[\"size\"]\n",
    "    print(f\"Object recall by size: small {s['small_detected']}/{s['small_total']} | large {s['large_detected']}/{s['large_total']}\")\n",
    "    tp, fp, fn, tn = report[\"confusion\"]\n",
    "    print(f\"Pixel confusion matrix: TP {tp}  FP {fp}  FN {fn}  TN {tn}\")\n",
    "\n",
    "val_report = full_report(gt_val, score_val, THRESHOLD)\n",
    "print_report(val_report)"
   ]
  },
