   "source": [
    "# One row per backbone: feature-AE quality, the best control on the same features, size and speed\n",
    "ae = backbone_df[backbone_df[\"method\"] == \"feature AE\"].set_index(\"backbone\")\n",
    "controls = backbone_df[backbone_df[\"method\"] != \"feature AE\"].groupby(\"backbone\")[\"AuPRC\"].max()\n",
    "overall = pd.DataFrame({\n",
    "    \"feature AE AuPRC\": ae[\"AuPRC\"], \"feature AE AUROC\": ae[\"AUROC\"], f\"feature AE AUPRO@{FPR_LIMIT}\": ae[f\"AUPRO@{FPR_LIMIT}\"],\n",
    "    \"best control AuPRC\": controls,\n",
    "    \"AE - control\": (ae[\"AuPRC\"] - controls).round(3),\n",
    "    \"channels\": ae[\"channels\"],\n",
    "    \"parameters (M)\": pd.Series({n: i[\"parameters (M)\"] for n, i in backbone_info.items()}).round(1),\n",
    "    \"ms / image\": pd.Series({n: i[\"ms / image\"] for n, i in backbone_info.items()}).round(1),\n",
    "}).sort_values(\"feature AE AuPRC\", ascending=False)\n",
    "overall.insert(0, \"rank\", range(1, len(overall) + 1))\n",
    "print(\"GPU:\", GPU_NAME)\n",
    "overall"
   ]
