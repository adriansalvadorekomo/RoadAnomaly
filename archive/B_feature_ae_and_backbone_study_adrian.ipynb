    "def auprc(gt, scores):\n",
    "    \"\"\"Pixel AuPRC, the main metric of the protocol.\"\"\"\n",
    "    return average_precision_score(gt.ravel(), scores.ravel())\n",
    "\n",
    "SIGMA_V2 = max(SIGMA_CANDIDATES, key=lambda s: auprc(gt_val, anomaly_scores(err_val_seeds[0], s)))\n",
    "\n",
    "# Ablation on validation: add one component at a time, keep it only if AuPRC rises by more than KEEP_MARGIN\n",
    "config = {\"sigma\": SIGMA, \"use_ensemble\": False, \"use_prior\": False}\n",
    "score_val_v2 = v2_scores(err_val_seeds, **config)\n",
    "ablation = [{\"step\": \"v1: pixel AE (sections 4-8)\", **threshold_free_scores(gt_val, score_val), \"kept\": \"-\"},\n",
    "            {\"step\": f\"feature AE on {FEATURE_LAYER} (1 seed, sigma {SIGMA})\",\n",
    "             **threshold_free_scores(gt_val, score_val_v2), \"kept\": \"-\"}]\n",
    "for name, change in [(f\"+ smoothing chosen on val (sigma {SIGMA_V2})\", {\"sigma\": SIGMA_V2}),\n",
    "                     (f\"+ road prior (rows < {ROAD_TOP_ROW})\", {\"use_prior\": True}),\n",
    "                     (f\"+ {len(ENSEMBLE_SEEDS)}-seed ensemble\", {\"use_ensemble\": True})]:\n",
    "    trial = {**config, **change}\n",
    "    trial_scores = v2_scores(err_val_seeds, **trial)\n",
    "    row = threshold_free_scores(gt_val, trial_scores)\n",
    "    kept = row[\"AuPRC\"] > auprc(gt_val, score_val_v2) + KEEP_MARGIN\n",
    "    if kept:\n",
    "        config, score_val_v2 = trial, trial_scores\n",
    "    ablation.append({\"step\": name, **row, \"kept\": \"yes\" if kept else \"no\"})\n",
    "\n",
    "# The control: the same standardised features, no AE, with the same final post-processing\n",
    "no_ae_val = v2_scores([upsample(np.linalg.norm(data[\"val\"], axis=-1))], config[\"sigma\"],\n",
    "                      use_ensemble=False, use_prior=config[\"use_prior\"])\n",
    "ablation.append({\"step\": f\"control: {FEATURE_LAYER} features, no AE (same post-processing)\",\n",
    "                 **threshold_free_scores(gt_val, no_ae_val), \"kept\": \"-\"})\n",
    "\n",
    "ablation_df = pd.DataFrame(ablation).drop(columns=[\"AuPRC chance\", \"AUROC chance\", \"AUPRO chance\"]).round(3)\n",
    "print(\"Final v2 configuration:\", config)\n",
    "ablation_df"
   ]
  },
