    "import time\n",
    "from sklearn.covariance import LedoitWolf\n",
    "\n",
    "A = keras.applications\n",
    "\n",
    "# Backbones compared at the same depth as v2 (stride 16, 22x40 cells), at the end of the stride-16 stage\n",
    "BACKBONES = {   # name: (constructor, layer at the end of the stride-16 stage, preprocessing)\n",
    "    \"VGG16\": (A.VGG16, \"block5_conv3\", A.vgg16.preprocess_input),\n",
    "    \"VGG19\": (A.VGG19, \"block5_conv4\", A.vgg19.preprocess_input),\n",
    "    \"ResNet50\": (A.ResNet50, \"conv4_block6_out\", A.resnet50.preprocess_input),\n",
    "    \"ResNet101\": (A.ResNet101, \"conv4_block23_out\", A.resnet.preprocess_input),\n",
    "    \"ResNet50V2\": (A.ResNet50V2, \"conv4_block5_out\", A.resnet_v2.preprocess_input),  # V2 downsamples in the last block\n",
    "    \"DenseNet121\": (A.DenseNet121, \"conv4_block24_concat\", A.densenet.preprocess_input),\n",
    "    \"Xception\": (A.Xception, \"block13_sepconv1_act\", A.xception.preprocess_input),     # middle-flow output (after ReLU)\n",
    "    # These models have their preprocessing inside: they take 0-255 images as they are\n",
    "    \"MobileNetV3Large\": (A.MobileNetV3Large, \"expanded_conv_11_add\", lambda images: images),\n",
    "    \"EfficientNetB0\": (A.EfficientNetB0, \"block5c_add\", lambda images: images),\n",
    "    \"EfficientNetV2S\": (A.EfficientNetV2S, \"block5i_add\", lambda images: images),\n",
    "    \"ConvNeXtTiny\": (A.ConvNeXtTiny, \"convnext_tiny_stage_2_block_8_identity\", lambda images: images),\n",
    "}\n",
    "\n",
    "def build_extractor(name):\n",
    "    \"\"\"Frozen ImageNet backbone cut at the stride-16 layer of BACKBONES[name].\"\"\"\n",
    "    constructor, layer, _ = BACKBONES[name]\n",
    "    base = constructor(include_top=False, weights=\"imagenet\")\n",
    "    base.trainable = False\n",
    "    return keras.Model(base.input, base.get_layer(layer).output, name=f\"{name}_extractor\")\n",
    "\n",
    "backbone_extractors = {name: build_extractor(name) for name in BACKBONES}   # built once\n",
    "\n",
    "def backbone_features(images, name):\n",
    "    \"\"\"Features of images in [0, 1] from one backbone, with that backbone's own preprocessing.\"\"\"\n",
    "    preprocess = BACKBONES[name][2]\n",
    "    return backbone_extractors[name].predict(preprocess(images * 255.0), batch_size=2, verbose=0)\n",
    "\n",
    "def ms_per_image(name, images, repeats=3):\n",
    "    \"\"\"Feature-extraction time on this GPU, in ms per 352x640 image (after one warm-up call).\"\"\"\n",
    "    backbone_features(images[:2], name)\n",
    "    start = time.perf_counter()\n",
    "    for _ in range(repeats):\n",
    "        backbone_features(images, name)\n",
    "    return 1000 * (time.perf_counter() - start) / (repeats * len(images))\n",
    "\n",
    "for name in BACKBONES:\n",
    "    print(f\"{name:17s} features: {backbone_features(x_val[:1], name).shape}\")"
   ]
