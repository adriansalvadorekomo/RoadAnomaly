   ],
   "source": [
    "def normal_cells(masks, cell_shape, margin=FEATURE_MARGIN):\n",
    "    \"\"\"True for each feature cell whose image region holds no anomaly pixel (obstacles dilated by `margin` px).\"\"\"\n",
    "    cells = []\n",
    "    for mask in masks[..., 0]:\n",
    "        unsafe = ndimage.binary_dilation(mask > 0, iterations=margin).astype(\"float32\")[..., None]\n",
    "        # \"area\" resizing averages the pixels of each cell: 0 means no unsafe pixel at all\n",
    "        cells.append(tf.image.resize(unsafe, cell_shape, method=\"area\").numpy()[..., 0] == 0)\n",
    "    return np.stack(cells)\n",
    "\n",
    "def standardise_features(features, mean, std):\n",
    "    \"\"\"Per-channel z-score with statistics computed on the TRAIN normal cells.\"\"\"\n",
    "    return (features - mean) / std\n",
    "\n",
    "def prepare_features(layer):\n",
    "    \"\"\"Standardised train / val feature maps of one VGG layer, with their normal-cell masks and statistics.\"\"\"\n",
    "    f_train, f_val = vgg_features(x_train, layer), vgg_features(x_val, layer)\n",
    "    ok_train, ok_val = normal_cells(y_train, f_train.shape[1:3]), normal_cells(y_val, f_val.shape[1:3])\n",
    "    mean, std = f_train[ok_train].mean(axis=0), f_train[ok_train].std(axis=0) + 1e-6\n",
    "    return {\"train\": standardise_features(f_train, mean, std), \"val\": standardise_features(f_val, mean, std),\n",
    "            \"ok_train\": ok_train, \"ok_val\": ok_val, \"mean\": mean, \"std\": std}\n",
    "\n",
    "# Shapes and share of normal cells for the deepest layer\n",
    "example = prepare_features(\"block5_conv3\")\n",
    "print(\"train features:\", example[\"train\"].shape, \"| val features:\", example[\"val\"].shape)\n",
    "print(f\"normal cells: train {example['ok_train'].mean():.1%}, val {example['ok_val'].mean():.1%}\")\n",
    "del example"
   ]
  },
