   "source": [
    "# Road prior from the TRAIN masks only\n",
    "anomaly_per_row = y_train[..., 0].sum(axis=(0, 2))\n",
    "ROAD_TOP_ROW = int(np.argmax(np.cumsum(anomaly_per_row) / anomaly_per_row.sum() >= ROAD_PRIOR_SHARE))\n",
    "print(f\"ROAD_TOP_ROW = {ROAD_TOP_ROW} of {IMG_SIZE[0]} rows (top {100 * ROAD_TOP_ROW / IMG_SIZE[0]:.0f} % of the image)\")\n",
    "\n",
    "def apply_road_prior(scores, top_row):\n",
    "    \"\"\"Give the rows above `top_row` the lowest score of their own image (no obstacle expected there).\"\"\"\n",
    "    out = scores.copy()\n",
    "    for score_map in out:\n",
    "        score_map[:top_row] = score_map.min()\n",
    "    return out\n",
    "\n",
    "def v2_scores(error_maps_per_seed, sigma, use_ensemble, use_prior):\n",
    "    \"\"\"v2 post-processing: (average over seeds) -> smoothing + per-image z-score -> (road prior).\"\"\"\n",
    "    errors = np.mean(error_maps_per_seed, axis=0) if use_ensemble else error_maps_per_seed[0]\n",
    "    scores = anomaly_scores(errors, sigma)\n",
    "    return apply_road_prior(scores, ROAD_TOP_ROW) if use_prior else scores\n",
    "\n",
    "# Train the chosen feature AE with every ensemble seed (the first seed reproduces the run of 12.5)\n",
    "data = prepare_features(FEATURE_LAYER)\n",
    "ensemble = [train_feature_ae(data, seed)[0] for seed in ENSEMBLE_SEEDS]\n",
    "for seed, model in zip(ENSEMBLE_SEEDS, ensemble):\n",
    "    model.save(MODEL_DIR / f\"B_feature_ae_seed{seed}.keras\")   # git-ignored\n",
    "err_val_seeds = [feature_error_maps(model, data[\"val\"]) for model in ensemble]"
   ]
  },
