    "## 9. Explainability diagnostic (validation only)\n",
    "\n",
    "The anomaly score is a reconstruction error, not a classifier decision. This section therefore asks a narrowly defined question: **which bottleneck locations have positive gradients for the mean raw reconstruction error inside one validation-predicted anomaly region?** A Grad-CAM-style map is upsampled to image resolution and shown beside the input, reconstruction, error, ground truth, and predicted region. Ground truth is displayed only for context; it does not define the explanation target.\n",
    "\n",
    "Deletion/insertion curves perturb the pixels highlighted by the map and track that same fixed scalar. They are a sanity check, not proof of causal reasoning; image perturbations may be out of distribution, and the bottleneck map is spatially coarse. No test image or test label is used for XAI.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "f755c6d2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Validation frame: cones01_Beeston_MMB_A6_Middle_Street | target: mean raw RGB MSE in validation-predicted mask\n",
      "Target value: 0.014016 | attribution range: 0.000?0.998\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 2000x400 with 7 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Pick a validation image with a predicted anomaly region; if empty, use its top 1% score pixels.\n",
    "xai_index = int(np.argmax([m.sum() for m in val_report[\"masks\"]]))\n",
    "xai_image = x_val[xai_index]\n",
    "xai_reconstruction = recon_val[xai_index]\n",
    "xai_error_map = err_val[xai_index]\n",
    "xai_score_map = score_val[xai_index]\n",
    "xai_region = val_report[\"masks\"][xai_index].astype(bool)\n",
    "xai_region_source = \"validation-predicted mask\"\n",
    "if not xai_region.any():\n",
    "    xai_region = xai_score_map >= np.quantile(xai_score_map, 0.99)\n",
    "    xai_region_source = \"top 1% of validation score map (empty-mask fallback)\"\n",
    "assert xai_region.any(), \"Could not define a non-empty validation attribution region\"\n",
    "\n",
    "xai_model = keras.Model(\n",
    "    inputs=autoencoder.inputs,\n",
    "    outputs=[autoencoder.get_layer(\"code\").output, autoencoder.output],\n",
    ")\n",
    "xai_input_tensor = tf.convert_to_tensor(xai_image[None, ...], dtype=tf.float32)\n",
    "xai_region_tensor = tf.convert_to_tensor(xai_region[None, ...], dtype=tf.float32)\n",
    "with tf.GradientTape() as tape:\n",
    "    xai_features, xai_reconstruction_tensor = xai_model(xai_input_tensor, training=False)\n",
    "    tape.watch(xai_features)\n",
    "    xai_raw_error = tf.reduce_mean(tf.square(xai_input_tensor - xai_reconstruction_tensor), axis=-1)\n",
    "    xai_target = tf.math.divide_no_nan(\n",
    "        tf.reduce_sum(xai_raw_error * xai_region_tensor),\n",
    "        tf.reduce_sum(xai_region_tensor),\n",
    "    )\n",
    "xai_gradients = tape.gradient(xai_target, xai_features)\n",
    "if xai_gradients is None:\n",
    "    raise RuntimeError(\"Grad-CAM gradients are unavailable for the autoencoder code layer\")\n",
    "xai_weights = tf.reduce_mean(xai_gradients, axis=(1, 2), keepdims=True)\n",
    "xai_cam = tf.nn.relu(tf.reduce_sum(xai_weights * xai_features, axis=-1, keepdims=True))\n",
    "xai_cam = tf.image.resize(xai_cam, IMG_SIZE, method=\"bilinear\")[0, ..., 0]\n",
    "xai_cam = xai_cam / (tf.reduce_max(xai_cam) + 1e-8)\n",
    "xai_heatmap = xai_cam.numpy()\n",
    "assert xai_heatmap.shape == IMG_SIZE and np.isfinite(xai_heatmap).all()\n",
    "print(f\"Validation frame: {val_frames[xai_index]} | target: mean raw RGB MSE in {xai_region_source}\")\n",
    "print(f\"Target value: {float(xai_target):.6f} | attribution range: {xai_heatmap.min():.3f}?{xai_heatmap.max():.3f}\")\n",
    "\n",
    "fig, ax = plt.subplots(1, 6, figsize=(20, 4), tight_layout=True)\n",
    "ax[0].imshow(xai_image); ax[0].set_title(\"Input\")\n",
    "ax[1].imshow(xai_reconstruction); ax[1].set_title(\"Reconstruction\")\n",
    "im = ax[2].imshow(xai_error_map, cmap=\"magma\"); ax[2].set_title(\"Raw reconstruction error\")\n",
    "ax[3].imshow(xai_image); ax[3].imshow(xai_heatmap, cmap=\"jet\", alpha=0.45); ax[3].set_title(\"Grad-CAM candidate\")\n",
    "ax[4].imshow(xai_region, cmap=\"gray\"); ax[4].set_title(\"Fixed target region\")\n",
    "ax[5].imshow(y_val[xai_index, ..., 0], cmap=\"gray\"); ax[5].set_title(\"GT (context only)\")\n",
    "for a in ax: a.axis(\"off\")\n",
    "fig.colorbar(im, ax=ax[2], fraction=0.046, pad=0.04)\n",
    "plt.savefig(FIG_DIR / \"B_03_validation_gradcam.png\", dpi=100, bbox_inches=\"tight\")\n",
    "plt.show()\n"
   ]
