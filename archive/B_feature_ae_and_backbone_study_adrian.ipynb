    "# v2 constants (each one is either chosen on validation below, or fixed with the reason given)\n",
    "FEATURE_LAYERS = [\"block3_conv3\", \"block4_conv3\", \"block5_conv3\"]  # 3 VGG16 depths: 1 cell = 4, 8, 16 px\n",
    "FEATURE_MARGIN = 4              # px added around obstacles before marking a feature cell as normal (= MASK_MARGIN)\n",
    "FEATURE_HIDDEN = 256            # width of the hidden layers of the feature autoencoder\n",
    "FEATURE_CODE_CHANNELS = 8       # bottleneck per cell (256 or 512 channels -> 8); 4, 8 and 32 gave the same\n",
    "                                # val AuPRC within 0.002 in a quick check, so a middle value is fixed, not tuned\n",
    "FEATURE_EPOCHS = 300            # upper bound; early stopping decides\n",
    "FEATURE_PATIENCE = 15\n",
    "FEATURE_BATCH_SIZE = 8          # 8 whole feature maps per step\n",
    "ENSEMBLE_SEEDS = [SEED, SEED + 1, SEED + 2]\n",
    "ROAD_PRIOR_SHARE = 0.01         # ignore the top rows that hold < 1 % of the TRAIN anomaly pixels\n",
    "MIN_BLOB_CANDIDATES = [MIN_OBJECT_PX, 64, 256]   # smallest predicted blob kept (px), chosen on validation\n",
    "KEEP_MARGIN = 0.002             # seed noise of the val AuPRC (section 3.1): smaller gains are not real"
