    "def best_free_scores(gt, error_maps):\n",
    "    \"\"\"Threshold-free scores with the smoothing sigma chosen on validation by AuPRC (same rule as 12.6).\"\"\"\n",
    "    sigma = max(SIGMA_CANDIDATES, key=lambda s: auprc(gt, anomaly_scores(error_maps, s)))\n",
    "    return {\"sigma\": sigma, **threshold_free_scores(gt, anomaly_scores(error_maps, sigma))}\n",
    "\n",
    "backbone_rows, backbone_info = [], {}\n",
    "for name in BACKBONES:\n",
    "    backbone_info[name] = {\"parameters (M)\": backbone_extractors[name].count_params() / 1e6,\n",
    "                           \"ms / image\": ms_per_image(name, x_val)}\n",
    "    data = prepare_backbone_features(name)\n",
    "    score_maps = {\"feature norm (no training)\": upsample(np.linalg.norm(data[\"val\"], axis=-1)),\n",
    "                  \"Mahalanobis (full Gaussian)\": mahalanobis_maps(fit_gaussian(data), data[\"val\"]),\n",
    "                  \"feature AE\": feature_error_maps(train_feature_ae(data, SEED)[0], data[\"val\"])}\n",
    "    for method, error_maps in score_maps.items():\n",
    "        row = best_free_scores(gt_val, error_maps)\n",
    "        backbone_rows.append({\"backbone\": name, \"channels\": data[\"val\"].shape[-1], \"method\": method,\n",
    "                              \"sigma\": row[\"sigma\"], \"AuPRC\": row[\"AuPRC\"], \"AUROC\": row[\"AUROC\"],\n",
    "                              f\"AUPRO@{FPR_LIMIT}\": row[f\"AUPRO@{FPR_LIMIT}\"]})\n",
    "del data\n",
    "backbone_df = pd.DataFrame(backbone_rows).round(3)\n",
    "backbone_df"
   ]
  },
