    "# Apply the rule fixed at the start of section 14: the final model is the best feature AE on validation\n",
    "ae_rows = backbone_df[backbone_df[\"method\"] == \"feature AE\"].set_index(\"backbone\")\n",
    "best_backbone = ae_rows[\"AuPRC\"].idxmax()\n",
    "gain_over_v2 = ae_rows.loc[best_backbone, \"AuPRC\"] - ae_rows.loc[\"VGG16\", \"AuPRC\"]\n",
    "FINAL_BACKBONE = best_backbone if gain_over_v2 > KEEP_MARGIN else \"VGG16\"\n",
    "print(\"Feature AE, val AuPRC per backbone:\", ae_rows[\"AuPRC\"].to_dict())\n",
    "print(f\"Best AE backbone: {best_backbone} (gain over v2 = {gain_over_v2:+.3f}) -> final backbone: {FINAL_BACKBONE}\")\n",
    "print(\"Test split used again:\", FINAL_BACKBONE != \"VGG16\")"
   ]
