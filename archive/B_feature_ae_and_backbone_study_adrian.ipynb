    "def evaluate_map(gt, error_maps, sigma):\n",
    "    \"\"\"Pixel AuPRC and AUROC of a raw error map after the usual post-processing (smoothing + per-image z).\"\"\"\n",
    "    scores = anomaly_scores(error_maps, sigma)\n",
    "    return {\"AuPRC\": average_precision_score(gt.ravel(), scores.ravel()),\n",
    "            \"AUROC\": roc_auc_score(gt.ravel(), scores.ravel())}\n",
    "\n",
    "# Perceptual error of the v1 pixel AE vs the control without any reconstruction (validation, sigma of v1)\n",
    "control_rows = [{\"layer\": \"pixels\", \"score map\": \"v1: pixel AE, MSE\", **evaluate_map(gt_val, err_val, SIGMA)}]\n",
    "for layer in FEATURE_LAYERS:\n",
    "    f_image, f_recon = vgg_features(x_val, layer), vgg_features(recon_val, layer)\n",
    "    perceptual = upsample(((f_image - f_recon) ** 2).mean(axis=-1))\n",
    "    no_reconstruction = upsample(np.linalg.norm(f_image, axis=-1))\n",
    "    control_rows.append({\"layer\": layer, \"score map\": \"pixel AE, perceptual error\",\n",
    "                         **evaluate_map(gt_val, perceptual, SIGMA)})\n",
    "    control_rows.append({\"layer\": layer, \"score map\": \"control: feature norm, no AE\",\n",
    "                         **evaluate_map(gt_val, no_reconstruction, SIGMA)})\n",
    "print(f\"AuPRC chance level on val = {gt_val.mean():.3f}\")\n",
    "pd.DataFrame(control_rows).round(3)"
   ]
  },
