    "def to_masks(scores, threshold, min_blob=MIN_OBJECT_PX):\n",
    "    \"\"\"Threshold the score maps, then drop blobs smaller than `min_blob` px (default: the speckle limit).\"\"\"\n",
    "    return np.stack([metrics.remove_small_components(s >= threshold, min_blob) for s in scores])\n",
    "\n",
    "def mean_f1(gt, scores, threshold, min_blob=MIN_OBJECT_PX):\n",
    "    \"\"\"Per-image mean F1 of the masks obtained with this threshold.\"\"\"\n",
    "    return metrics.evaluate_masks(list(gt), list(to_masks(scores, threshold, min_blob)))[\"per_image_mean\"][\"f1\"]\n",
    "\n",
    "candidates = np.quantile(score_val, THRESHOLD_QUANTILES)\n",
    "f1_per_threshold = [mean_f1(gt_val, score_val, t) for t in candidates]\n",
    "THRESHOLD = float(candidates[int(np.argmax(f1_per_threshold))])\n",
    "print(f\"Chosen threshold: {THRESHOLD:.5f} (val per-image mean F1 = {max(f1_per_threshold):.4f})\")\n",
    "\n",
    "plt.figure(figsize=(8, 3.5))\n",
    "plt.plot(candidates, f1_per_threshold)\n",
    "plt.axvline(THRESHOLD, color=\"red\", linestyle=\"--\", label=\"chosen\")\n",
    "plt.xlabel(\"threshold on the anomaly score (z)\")\n",
    "plt.ylabel(\"per-image mean F1 (val)\")\n",
    "plt.title(\"Threshold selection on validation\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
