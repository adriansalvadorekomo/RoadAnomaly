    "def summary_column(free, report):\n",
    "    \"\"\"Main protocol numbers of one model on one split.\"\"\"\n",
    "    pixel, objects = report[\"pixel\"][\"per_image_mean\"], report[\"objects\"]\n",
    "    return {\"AuPRC (main)\": f\"{free['AuPRC']:.3f}\", \"AUROC\": f\"{free['AUROC']:.3f}\",\n",
    "            f\"AUPRO @ FPR {FPR_LIMIT}\": f\"{free[f'AUPRO@{FPR_LIMIT}']:.3f}\",\n",
    "            \"pixel F1 = Dice (per-image mean)\": f\"{pixel['f1']:.3f}\",\n",
    "            \"pixel IoU (per-image mean)\": f\"{pixel['iou']:.3f}\",\n",
    "            \"precision / recall (per-image mean)\": f\"{pixel['precision']:.3f} / {pixel['recall']:.3f}\",\n",
    "            \"object recall\": f\"{objects['detected'].sum()}/{objects['gt_objects'].sum()}\",\n",
    "            \"false alarms / predicted blobs\": f\"{objects['false_alarms'].sum()}/{objects['pred_objects'].sum()}\"}\n",
    "\n",
    "def bootstrap_column(report):\n",
    "    \"\"\"95 % bootstrap intervals over the test images for the per-image metrics.\"\"\"\n",
    "    per_image = report[\"pixel\"][\"per_image\"]\n",
    "    column = {}\n",
    "    for key, name in [(\"f1\", \"pixel F1 = Dice (per-image mean)\"), (\"iou\", \"pixel IoU (per-image mean)\")]:\n",
    "        _, low, high = metrics.bootstrap_ci([s[key] for s in per_image])\n",
    "        column[name] = f\"{low:.3f} - {high:.3f}\"\n",
    "    return column\n",
    "\n",
    "# v1 vs v2, validation and test, with the bootstrap intervals of both models on test\n",
    "comparison = pd.DataFrame({\"v1 val\": summary_column(val_free, val_report),\n",
    "                           \"v2 val\": summary_column(val_free_v2, val_report_v2),\n",
    "                           \"v1 test\": summary_column(test_free, test_report),\n",
    "                           \"v2 test\": summary_column(test_free_v2, test_report_v2),\n",
    "                           \"v1 test 95% CI\": bootstrap_column(test_report),\n",
    "                           \"v2 test 95% CI\": bootstrap_column(test_report_v2)}).fillna(\"\")\n",
    "comparison"
   ]
  },
