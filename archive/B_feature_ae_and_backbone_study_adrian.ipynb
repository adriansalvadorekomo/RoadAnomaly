    "# Preprocessing\n",
    "PATCH = 64                     # patch size for training the autoencoder\n",
    "STRIDE = 32                    # patches overlap by half\n",
    "MASK_MARGIN = 4                # px added around each obstacle before selecting normal patches\n",
