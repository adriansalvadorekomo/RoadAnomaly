---
// RoadAnomaly landing page: "a paper whose figures work".
// It is set like a deep learning paper (title block, abstract, equations, figure captions, margin notes,
// citations, references) and told like a product story (hook, stakes, three answers, proof, explanations,
// limits, a closing invitation). Every number comes from reports/results/test_results.json (notebook 5)
// and public/demo/demo.json (scripts/export_demo.py); nothing is typed in by hand.
import fs from "node:fs";
import path from "node:path";
import Cite from "../components/Cite.astro";
import "../styles/global.css";
import "../styles/sections.css";
import "../styles/paper.css";
import results from "../data/results.json";

const PUBLIC = path.join(process.cwd(), "public");
const demoPath = path.join(PUBLIC, "demo", "demo.json");
const demo = fs.existsSync(demoPath) ? JSON.parse(fs.readFileSync(demoPath, "utf8")) : { images: [], models: [], gallery: [], receipt: {} };

const DEMO_URL = import.meta.env.PUBLIC_DEMO_URL ?? "http://localhost:8501";
const API_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000/docs";
const REPO_URL = "https://github.com/adriansalvadorekomo/RoadAnomaly-CRISPDM";

// ---- the single test evaluation, one report per model
const order = ["A_deeplabv3plus", "B_feature_ae", "B_pixel_ae", "C_cnn", "C_unet", "C_unet_resnet50"];
const shortName = { A_deeplabv3plus: "DeepLabV3+", B_feature_ae: "Feature autoencoder", B_pixel_ae: "Pixel autoencoder",
                    C_cnn: "CNN baseline", C_unet: "U-Net", C_unet_resnet50: "U-Net ResNet50" };
const team = { A: "Ines and Emna", B: "Khaled and Adrian", C: "Hejer and Walid" };
const models = order.filter((n) => results.models?.[n]).map((n) => ({ name: n, short: shortName[n], ...results.models[n] }));
const fmt = (v, d = 3) => (typeof v === "number" && Number.isFinite(v) ? v.toFixed(d) : "–");
const ci = (m, metric) => m.bootstrap?.find((r) => r.metric === metric) ?? {};
const latency = (m) => Object.entries(m.cost ?? {}).find(([k]) => k.startsWith("latency"))?.[1];
const pass = (text) => String(text).includes("pass");
const f1Of = (m) => m?.summary?.["F1 = Dice (per-image mean)"] ?? 0;
const byF1 = [...models].sort((a, b) => f1Of(b) - f1Of(a));
const best = byF1[0], second = byF1[1];
const allPass = models.filter((m) => Object.values(m.criteria ?? {}).every(pass));
const fastest = models.reduce((a, b) => ((latency(b) ?? 1e9) < (latency(a) ?? 1e9) ? b : a), models[0]);
const pair = (a, b) => (results.paired_differences ?? []).find((r) => r["A - B"] === `${a} - ${b}` && r.metric === "per-image f1");
const bestPair = best && second ? pair(best.name, second.name) ?? pair(second.name, best.name) : null;
const testObjects = best?.summary?.["objects detected"]?.split("/")[1] ?? "22";
const chance = best?.threshold_free?.["AuPRC chance"];

// ---- the receipt: photographs per split and category
const receiptOrder = [["train", "Training"], ["val", "Validation"], ["test", "Test"]];
const receiptTotal = Object.values(demo.receipt).reduce((s, g) => s + Object.values(g).reduce((a, b) => a + b, 0), 0);

// ---- photo credits
const photos = [...demo.images, ...demo.gallery];
const pretty = (frame) => { const t = frame.replace(/^[a-z_]+\d+_?/, "").replaceAll("_", " "); return t.charAt(0).toUpperCase() + t.slice(1); };
const stripPairs = ["pair-1", "pair-2", "pair-3", "pair-4"];
const firstImage = demo.images[0];

// ---- figures copied from the notebooks (real pixel sizes, so the layout never jumps)
const figure = (name) => {
  const file = path.join(PUBLIC, "figures", name);
  if (!fs.existsSync(file)) return { src: `figures/${name}`, width: 1600, height: 900 };
  const header = fs.readFileSync(file).subarray(16, 24);
  return { src: `figures/${name}`, width: header.readUInt32BE(0), height: header.readUInt32BE(4) };
};
const testBoard = figure("5_01_test_predictions.png");
const xaiBoard = figure("6_01_xai_board_success.png");

// ---- references, cited in the text as [n]; pointing at a citation shows its entry
const refs = [
  { text: "K. Lis, K. Nakka, P. Fua, M. Salzmann. Detecting the Unexpected via Image Resynthesis. ICCV 2019.", url: "https://infoscience.epfl.ch/record/269093" },
  { text: "R. Chan et al. SegmentMeIfYouCan: A Benchmark for Anomaly Segmentation. NeurIPS Datasets and Benchmarks 2021." },
  { text: "L.-C. Chen et al. Encoder-Decoder with Atrous Separable Convolution for Semantic Image Segmentation. ECCV 2018." },
  { text: "O. Ronneberger, P. Fischer, T. Brox. U-Net: Convolutional Networks for Biomedical Image Segmentation. MICCAI 2015." },
  { text: "T. Defard et al. PaDiM: a Patch Distribution Modeling Framework for Anomaly Detection and Localization. ICPR 2021." },
  { text: "R. R. Selvaraju et al. Grad-CAM: Visual Explanations from Deep Networks via Gradient-based Localization. ICCV 2017." },
  { text: "V. Petsiuk, A. Das, K. Saenko. RISE: Randomized Input Sampling for Explanation of Black-box Models. BMVC 2018." },
  { text: "B. Cheng et al. Boundary IoU: Improving Object-Centric Image Segmentation Evaluation. CVPR 2021." },
  { text: "R. Wirth, J. Hipp. CRISP-DM: Towards a Standard Process Model for Data Mining. 2000." },
];
const [LIS, CHAN, CHEN, RONNEBERGER, DEFARD, SELVARAJU, PETSIUK, CHENG, WIRTH] = refs.map((_, i) => i + 1);

const contents = [
  ["abstract", "Abstract"], ["introduction", "Introduction"], ["method", "Three approaches"], ["protocol", "Protocol"],
  ["results", "Results"], ["explanations", "Explanations"], ["limitations", "Limitations"], ["conclusion", "Conclusion"],
  ["references", "References"],
];
const bibtex = `@techreport{roadanomaly2026,
  title       = {Road obstacles, pixel by pixel: three deep learning
                 approaches to road anomaly segmentation},
  author      = {Ines and Emna and Khaled and Adrian and Hejer and Walid},
  institution = {ESPRIT, Deep Learning module},
  year        = {2026},
  month       = nov,
  url         = {${REPO_URL}}
}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Road obstacles, pixel by pixel — RoadAnomaly</title>
    <meta name="description" content="A paper whose figures work: six deep learning models from three student teams find unexpected obstacles on real road photographs, pixel by pixel, under one honest protocol." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'><path d='M5 .6 9.6 9.4H.4z' fill='%230d7480'/></svg>" />
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <!-- RUNNING HEAD: as in a printed paper, the bar names the section being read; a filled bar shows progress -->
    <header class="runhead">
      <a class="wordmark" href="#top" aria-label="RoadAnomaly, back to the title">
        <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M5 .6 9.6 9.4H.4z" fill="currentColor" /></svg>RoadAnomaly
      </a>
      <p class="runhead__section"><span data-running-head>Road obstacles, pixel by pixel</span></p>
      <details class="toc-menu">
        <summary>Contents</summary>
        <nav aria-label="Contents, menu">
          <ol class="toc-menu__list" role="list">
            {contents.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
          </ol>
        </nav>
      </details>
      <a class="button button--small" href={DEMO_URL}><span class="label-long">Run the demo</span><span class="label-short">Demo</span></a>
      <span class="runhead__progress" aria-hidden="true"></span>
    </header>

    <!-- CONTENTS RAIL: the paper's outline in the left margin of wide screens, the current section marked -->
    <nav class="rail" aria-label="Contents">
      <p class="rail__title">Contents</p>
      <ol role="list">
        {contents.map(([id, label]) => <li><a href={`#${id}`} data-toc={id}>{label}</a></li>)}
      </ol>
    </nav>

    <main id="top" class="paper">
      <!-- TITLE BLOCK + FIGURE 1 (the live detector) -->
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero__copy">
          <h1 id="hero-title" class="hero__title lines">
            <span class="line"><span data-line style="--i:0">Road obstacles,</span></span>
            <span class="line"><span data-line style="--i:1">pixel by pixel.</span></span>
          </h1>
          <p class="hero__lead serif" data-load style="--d:420ms">Three deep learning approaches to finding what a road camera was never trained to see, compared under one honest protocol. Move the threshold in Figure 1 and watch a real model change its mind.</p>
          <dl class="byline" data-load style="--d:460ms">
            <div><dt>Authors</dt><dd>Ines, Emna, Khaled, Adrian, Hejer and Walid</dd></div>
            <div><dt>Affiliation</dt><dd>ESPRIT, Deep Learning module</dd></div>
            <div><dt>Published</dt><dd><time datetime="2026-11">November 2026</time></dd></div>
            <div><dt>Material</dt><dd><a class="text-link" href={REPO_URL}>code</a>, <a class="text-link" href={API_URL}>API</a>, <a class="text-link" href="#references">data</a></dd></div>
          </dl>
          <div class="hero__actions" data-load style="--d:520ms">
            <a class="button" href={DEMO_URL}>Run it on your own photo</a>
            <a class="text-link" href="#abstract">Read the abstract</a>
          </div>
        </div>

        <figure class="stage" id="live">
          {firstImage && (
            <div class="detector" data-ui aria-label="Live detector: a real model's answer on a real photograph">
              <div class="detector__view" style={`aspect-ratio: ${demo.size[1]} / ${demo.size[0]}`}>
                <img class="detector__photo" src={firstImage.photo} width="640" height="352" alt={firstImage.title} fetchpriority="high" />
                <canvas class="detector__mask" width={demo.size[1]} height={demo.size[0]} aria-hidden="true"></canvas>
                <noscript><img class="detector__fallback" src="demo/fallback.jpg" width="640" height="352" alt={`${firstImage.title}, with the anomaly mask of ${demo.models[0]?.title} at its validation threshold`} /></noscript>
              </div>
              <p class="detector__readout" aria-live="polite">
                <span><b data-out="f1">–</b> F1 against the annotation</span>
                <span><b data-out="area">–</b> of the photo flagged</span>
                <span><b data-out="blobs">–</b> obstacle blobs</span>
              </p>
              <div class="detector__photos" role="group" aria-label="Photograph">
                {demo.images.map((img, i) => (
                  <button type="button" data-photo={i} aria-pressed={i === 0 ? "true" : "false"} aria-label={img.title}>
                    <img src={img.photo} width="64" height="35" alt="" loading="lazy" />
                  </button>
                ))}
              </div>
            </div>
          )}
          <label class="chip chip--model" data-ui>
            <span class="chip__label">Model</span>
            <select data-control="model">
              {demo.models.map((m) => <option value={m.name}>{shortName[m.name] ?? m.title} · {m.binome}</option>)}
            </select>
          </label>
          <div class="chip chip--threshold" data-ui>
            <label class="chip__label" for="threshold">Threshold <output data-out="threshold" for="threshold">–</output></label>
            <input id="threshold" type="range" data-control="threshold" min="0" max="1" step="0.001" value="0.5" />
            <button type="button" class="chip__reset" data-control="reset">Validation value</button>
          </div>
          <button type="button" class="chip chip--truth" data-ui data-control="truth" aria-pressed="false">
            <span class="chip__label">Annotation outline</span>
            <span class="switch" aria-hidden="true"></span>
          </button>
          <figcaption class="stage__caption serif"><b>Figure 1.</b> A trained model's real score map on a validation photograph, re-thresholded in your browser. The default threshold is the one chosen on validation; F1 compares the mask with the human annotation.</figcaption>
        </figure>
      </section>

      <!-- ABSTRACT: the elevator pitch in the paper's own form, with its three proofs -->
      <section class="abstract wrap section" id="abstract" data-section="Abstract" aria-labelledby="abstract-title">
        <div class="abstract__body">
          <h2 id="abstract-title" class="abstract__title" data-reveal>Abstract</h2>
          <p class="serif abstract__text" data-reveal>A camera that labels every pixel of the road with a class it learned has no answer for a cow, a fallen rock or a lost tyre: it calls them road. We compare six models from three approaches (supervised segmentation, autoencoders that learn only what a normal road looks like, and U-Nets) on the RoadAnomaly benchmark<Cite n={LIS} refs={refs} />, under one frozen protocol and a test set opened once. {best?.short} finds {best?.summary?.["objects detected"]} obstacles with a mean F1 of {fmt(f1Of(best), 2)}, and {allPass.length === 1 ? `the ${allPass[0].short.toLowerCase()}, which never saw an annotated obstacle during training, is the only model that meets all four of our deployment criteria` : `${allPass.length} models meet all four of our deployment criteria`}.</p>
        </div>
        <ul class="proofs" role="list">
          <li data-reveal style="--i:0"><span class="proofs__figure nums">{fmt(f1Of(best), 2)}</span><span class="proofs__label serif">best mean F1 on the sealed test set, {best?.short}</span></li>
          <li data-reveal style="--i:1"><span class="proofs__figure nums">{fmt(latency(fastest), 0)} ms</span><span class="proofs__label serif">per photograph for the fastest model, {fastest?.short}, on a laptop GPU</span></li>
          <li data-reveal style="--i:2"><span class="proofs__figure nums">{models.length} to 1</span><span class="proofs__label serif">six models, three teams, judged by one frozen protocol</span></li>
        </ul>
      </section>

      <!-- INTRODUCTION: the hook and the stakes -->
      <section class="prose wrap section" id="introduction" data-section="Introduction" aria-labelledby="intro-title">
        <h2 id="intro-title" class="prose__title" data-reveal>A closed world misses the cow.</h2>
        <div class="prose__body">
          <p class="serif" data-reveal>Semantic segmentation networks give every pixel of a driving scene one of the classes they were trained on: road, car, person, sign. The list is closed. When something that is not on it stands in the lane, the network still has to answer, and it answers with the nearest class it knows, often with high confidence.</p>
          <aside class="note serif" data-reveal><b>RoadAnomaly</b> was built for exactly this question<Cite n={LIS} refs={refs} />: sixty photographs collected online, each with an unexpected obstacle outlined pixel by pixel. Larger benchmarks followed<Cite n={CHAN} refs={refs} />.</aside>
          <p class="serif" data-reveal>The useful answer is not a better class but a mask: <em>these</em> pixels are something the network did not expect. A mask says where the obstacle is and how large without knowing what it is, which is all a braking decision needs. That is the task the three teams set out to solve.</p>
          <p class="serif" data-reveal>Only about one pixel in ten is anomalous, so a model that flags nothing is already 90 % accurate. Accuracy is therefore never quoted here; every score below was chosen from measurements of the data, following CRISP-DM<Cite n={WIRTH} refs={refs} />.</p>
        </div>
        <figure class="gallery wide">
          <ul class="tiles" role="list">
            {demo.gallery.map((g, i) => (
              <li class={`tile ${stripPairs[i % 4]}`} data-reveal style={`--i:${i % 4}`}>
                <img src={g.photo} width={g.width} height={g.height} alt={`${g.category} on the road (${g.split} split)`} loading="lazy" />
                <div class="tile__strip nums">
                  <p class="tile__row"><span>{g.anomaly_percent} %</span><span>{g.objects} {g.objects === 1 ? "object" : "objects"}</span><span>{g.split}</span><span>{g.category}</span></p>
                  <p class="tile__row"><span>{g.author}</span><span>{g.licence}</span></p>
                </div>
              </li>
            ))}
          </ul>
          <figcaption class="serif caption" data-reveal><b>Figure 2.</b> Eight of the sixty photographs, with the share of anomalous pixels, the number of obstacles, the split and the photographer. Every photograph on this page is openly licensed.</figcaption>
        </figure>
      </section>

      <!-- METHOD: three answers, each with its idea -->
      <section class="prose wrap section" id="method" data-section="Three approaches" aria-labelledby="method-title">
        <h2 id="method-title" class="prose__title" data-reveal>Three ways to see an obstacle</h2>
        <div class="prose__body">
          <p class="serif" data-reveal>Each team took one idea from the course and owned it from the data to the explanation. All three end in the same object, a score per pixel turned into a mask by a threshold chosen on validation, so all six models are judged by the same rules.</p>

          <h3 class="prose__sub" data-reveal>Learn the masks: DeepLabV3+</h3>
          <p class="serif" data-reveal>Ines and Emna kept an ImageNet ResNet50 frozen as the encoder and trained an atrous pyramid and a decoder on the annotated masks<Cite n={CHEN} refs={refs} />. The network predicts a probability per pixel and learns from a cross-entropy loss.</p>

          <h3 class="prose__sub" data-reveal>Learn the normal road: autoencoders</h3>
          <p class="serif" data-reveal>Khaled and Adrian trained only on the obstacle-free parts of the training photographs. An autoencoder that has only seen normal road rebuilds an obstacle badly, so the reconstruction error <em>is</em> the anomaly score. Their final model works on frozen ImageNet features φ(x) rather than on pixels:</p>
          <div class="equation" data-reveal>
            <math display="block" aria-label="s of x equals one over C times the squared norm of phi of x minus g of phi of x">
              <mrow><mi>s</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>=</mo>
                <mfrac><mn>1</mn><mi>C</mi></mfrac>
                <msup><mrow><mo>‖</mo><mi>φ</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>−</mo><mi>g</mi><mo>(</mo><mi>φ</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>)</mo><mo>‖</mo></mrow><mn>2</mn></msup>
              </mrow>
            </math>
            <span class="equation__no">(1)</span>
          </div>
          <aside class="note serif" data-reveal>A Gaussian fitted on the same features<Cite n={DEFARD} refs={refs} /> scores about as well as the autoencoder: most of the work is done by ImageNet. We report it rather than hide it.</aside>

          <h3 class="prose__sub" data-reveal>Learn the masks, keep the detail: CNN and U-Nets</h3>
          <p class="serif" data-reveal>Hejer built an encoder–decoder CNN as the baseline; Walid added the skip connections of a U-Net<Cite n={RONNEBERGER} refs={refs} />, then a pretrained ResNet50 encoder and a loss that punishes missed pixels more than false alarms:</p>
          <div class="equation" data-reveal>
            <math display="block" aria-label="L equals the focal loss plus one minus the Tversky index, to the power gamma">
              <mrow><mi>ℒ</mi><mo>=</mo><msub><mi>ℒ</mi><mtext>focal</mtext></msub><mo>+</mo>
                <msup><mrow><mo>(</mo><mn>1</mn><mo>−</mo>
                  <mfrac><mrow><mi>T</mi><mi>P</mi></mrow><mrow><mi>T</mi><mi>P</mi><mo>+</mo><mi>α</mi><mi>F</mi><mi>P</mi><mo>+</mo><mi>β</mi><mi>F</mi><mi>N</mi></mrow></mfrac>
                <mo>)</mo></mrow><mi>γ</mi></msup>
              </mrow>
            </math>
            <span class="equation__no">(2)</span>
          </div>
          <aside class="note serif" data-reveal>With α = 0.3 and β = 0.7, a missed obstacle pixel costs more than a false alarm, which suits a warning system.</aside>
        </div>
      </section>

      <!-- PROTOCOL: the total and its receipt -->
      <section class="receipt wrap section" id="protocol" data-section="Protocol" aria-labelledby="receipt-title">
        <div class="receipt__left">
          <div>
            <h2 id="receipt-title" class="receipt__title" data-reveal>One protocol, frozen before the test.</h2>
            <p class="receipt__note serif" data-reveal>Scenes from the same video or article never cross a split, and the split is rebuilt from the raw files on every run and must come out identical. Thresholds, checkpoints and every design choice were made on the nine validation photographs; the nine test photographs were opened once, for all six models together.</p>
          </div>
          <p class="receipt__total nums" data-reveal><span class="receipt__figure">{receiptTotal}</span><span class="receipt__caption serif"><b>Table 1.</b> Annotated photographs in RoadAnomaly, by split and kind of obstacle.</span></p>
        </div>
        <div class="slip nums" data-reveal>
          {receiptOrder.map(([key, label]) => (
            <div class="slip__group">
              <p class="slip__name">{label}</p>
              <ul role="list">
                {Object.entries(demo.receipt[key] ?? {}).sort((a, b) => b[1] - a[1]).map(([cat, n]) => (
                  <li><span>{cat}</span><span class="slip__dots" aria-hidden="true"></span><span>{n}</span></li>
                ))}
              </ul>
            </div>
          ))}
          <p class="slip__total"><span>Total</span><span>{receiptTotal}</span></p>
        </div>
      </section>

      <!-- RESULTS: one report per model -->
      <section class="reports wrap section" id="results" data-section="Results" aria-labelledby="reports-title">
        <div class="reports__index">
          <h2 id="reports-title" class="reports__title" data-reveal>Results on a sealed test set</h2>
          <ul class="reports__names" role="list">
            {models.map((m, i) => (
              <li><button type="button" class="reports__name" data-report={m.name} aria-pressed={i === 0 ? "true" : "false"}>{m.short}</button></li>
            ))}
          </ul>
          <p class="reports__note serif" data-reveal><b>Table 2.</b> Nine test photographs and {testObjects} obstacles, evaluated once with thresholds fixed on validation. Intervals are 95 % bootstrap intervals over images; chance AuPRC is {fmt(chance)}.</p>
        </div>
        <div class="reports__stage">
          {models.map((m, i) => {
            const f1 = ci(m, "pixel f1"), iou = ci(m, "pixel iou");
            const s = m.summary ?? {};
            return (
              <article class="sheet" data-ui data-sheet={m.name} hidden={i !== 0} aria-label={`Evaluation report, ${m.short}`}>
                <h3>{m.short}, evaluation report</h3>
                <p class="sheet__model">{m.config?.title}. Binôme {m.binome}: {team[m.binome]}.</p>
                <table class="sheet__table nums">
                  <caption class="sheet__caption">Frozen test split, 9 photographs.</caption>
                  <tbody>
                    <tr><th scope="row">AuPRC, the main score</th><td>{fmt(s["AuPRC (main)"])}</td></tr>
                    <tr><th scope="row">F1 = Dice, mean per photo</th><td>{fmt(f1.mean)} <span class="sheet__ci">{fmt(f1.low, 2)} to {fmt(f1.high, 2)}</span></td></tr>
                    <tr><th scope="row">IoU, mean per photo</th><td>{fmt(iou.mean)} <span class="sheet__ci">{fmt(iou.low, 2)} to {fmt(iou.high, 2)}</span></td></tr>
                    <tr><th scope="row">Precision / recall</th><td>{fmt(s["precision (per-image mean)"], 2)} / {fmt(s["recall (per-image mean)"], 2)}</td></tr>
                    <tr><th scope="row">Obstacles found</th><td>{s["objects detected"]}</td></tr>
                    <tr><th scope="row">False alarms / predicted blobs</th><td>{s["false alarms / predicted blobs"]}</td></tr>
                    <tr><th scope="row">Outline quality, Boundary IoU</th><td>{fmt(s["Boundary IoU (15 px band)"])}</td></tr>
                    <tr><th scope="row">Background flagged at 95 % recall</th><td>{fmt(s["FPR95 (lower is better)"])}</td></tr>
                    <tr><th scope="row">Time per photo, RTX 4060</th><td>{fmt(latency(m), 0)} ms</td></tr>
                    <tr><th scope="row">Threshold, chosen on validation</th><td>{fmt(m.config?.postprocessing?.threshold)}</td></tr>
                  </tbody>
                </table>
                <ul class="sheet__checks" role="list" aria-label="Business success criteria">
                  {Object.entries(m.criteria ?? {}).map(([k, v]) => (
                    <li class={pass(v) ? "is-pass" : "is-fail"}><span>{k.replace(/^SC\d /, "")}</span><span>{String(v).split(":")[0]}</span></li>
                  ))}
                </ul>
              </article>
            );
          })}
        </div>
      </section>

      <section class="prose wrap section" data-section="Results" aria-labelledby="verdict-title">
        <h2 id="verdict-title" class="prose__title" data-reveal>No winner, three ways to fail</h2>
        <div class="prose__body">
          <p class="serif lede" data-reveal>{best?.short} leads {second?.short} by {fmt(bestPair?.["mean difference"], 2)} in F1, but the paired interval runs from {fmt(bestPair?.["95% low"], 2)} to {fmt(bestPair?.["95% high"], 2)}. On nine photographs, <strong>no winner is declared</strong>. What separates the models is how they fail.</p>
          <aside class="note serif" data-reveal>A paired bootstrap resamples the nine photographs and compares both models on the same draw, so the difficulty of each photograph cancels out.</aside>
          <p class="serif" data-reveal>The supervised models find the most obstacles and draw the best outlines<Cite n={CHENG} refs={refs} />, but scatter small false alarms. The feature autoencoder finds fewer obstacles and draws coarser shapes, yet most of its warnings are real, which is why it alone passes all four criteria. Learning from pixels alone, the pixel autoencoder reacts to texture: foliage and façades rather than cows.</p>
        </div>
        <figure class="wide" data-reveal>
          <img src={testBoard.src} width={testBoard.width} height={testBoard.height} alt="Each test photograph with its annotation and the masks of the six models" loading="lazy" />
          <figcaption class="serif caption"><b>Figure 3.</b> Every test photograph, its annotation and the six models' masks. White pixels are found, red pixels are false alarms, blue pixels are missed.</figcaption>
        </figure>
      </section>

      <!-- EXPLANATIONS -->
      <section class="prose wrap section" id="explanations" data-section="Explanations" aria-labelledby="xai-title">
        <h2 id="xai-title" class="prose__title" data-reveal>Why the models flag what they flag</h2>
        <div class="prose__body">
          <p class="serif" data-reveal>A score map shows <em>where</em> a model reacts. To ask <em>why</em>, we used Grad-CAM<Cite n={SELVARAJU} refs={refs} /> on the decoder of each segmentation network and on the bottleneck of each autoencoder, always for the same fixed region, and on validation photographs only.</p>
          <p class="serif" data-reveal>A heatmap can look convincing and still be wrong, so each one was tested: the regions it ranks first are blurred away, and the model's score should fall faster than when regions are removed in random order<Cite n={PETSIUK} refs={refs} />. For four of the six models it does. For the feature autoencoder it does not, because blurring a region makes it look unusual to an autoencoder.</p>
          <aside class="note serif" data-reveal>An error map is a detection map, not a causal explanation, and a heatmap never replaces a segmentation metric.</aside>
        </div>
        <figure class="wide" data-reveal>
          <img src={xaiBoard.src} width={xaiBoard.width} height={xaiBoard.height} alt="Explanation board: photograph, annotation, predicted mask, detection map and Grad-CAM for each model" loading="lazy" />
          <figcaption class="serif caption"><b>Figure 4.</b> One validation photograph seen by each model: the annotation, the predicted mask, the score map and the Grad-CAM of the predicted region.</figcaption>
        </figure>
      </section>

      <!-- LIMITATIONS -->
      <section class="limits wrap section" id="limitations" data-section="Limitations" aria-labelledby="limits-title">
        <div class="limits__column">
          <h2 id="limits-title" class="limits__title" data-reveal>What this does not show</h2>
          <div class="limits__group">
            <p class="limits__group-name" data-reveal>Limits</p>
            <ul role="list">
              <li data-reveal><span class="dot dot--1"></span><span>Nine test photographs: one photo moves a mean by about 11 %</span><span class="limits__value">n = 9</span></li>
              <li data-reveal><span class="dot dot--1"></span><span>Trained and tested on RoadAnomaly: not an out-of-distribution benchmark score</span><span class="limits__value">60 photos</span></li>
              <li data-reveal><span class="dot dot--1"></span><span>For the autoencoders, ImageNet pretraining does most of the work</span><span class="limits__value">AE ≈ Gaussian</span></li>
              <li data-reveal><span class="dot dot--1"></span><span>No small obstacle in the test split; small ones are judged on validation only</span><span class="limits__value">0 small</span></li>
              <li data-reveal><span class="dot dot--1"></span><span>A research prototype measured on a laptop GPU, not a safety system</span><span class="limits__value">RTX 4060</span></li>
            </ul>
          </div>
          <div class="limits__group">
            <p class="limits__group-name" data-reveal>Earlier looks at the test set, disclosed</p>
            <ul role="list">
              <li data-reveal><span class="dot dot--2"></span><span>DeepLabV3+, Ines's original run</span><span class="limits__value">1</span></li>
              <li data-reveal><span class="dot dot--2"></span><span>Pixel autoencoder, two code variants and one historical check</span><span class="limits__value">3</span></li>
              <li data-reveal><span class="dot dot--2"></span><span>Feature autoencoder, before the backbone study</span><span class="limits__value">1</span></li>
              <li data-reveal><span class="dot dot--2"></span><span>U-Nets, on Walid's own split before the port</span><span class="limits__value">2</span></li>
              <li data-reveal><span class="dot dot--2"></span><span>CNN baseline</span><span class="limits__value">0</span></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- CONCLUSION: a short letter from the group -->
      <section class="letter wrap section" id="conclusion" data-section="Conclusion" aria-labelledby="letter-title">
        <div class="letter__column">
          <h2 id="letter-title" class="letter__title" data-reveal>Conclusion</h2>
          <p class="serif" data-reveal>We started from a worry the course kept raising: the networks we study are confident about everything, including things they have never seen.</p>
          <p class="serif" data-reveal>RoadAnomaly made the worry concrete. Sixty photographs, each with something on the road that a closed list of classes would miss. Too few to train a giant model, enough to compare three ideas carefully.</p>
          <p class="serif" data-reveal>The most useful result was a humbling one. <mark>For the autoencoders, a simple Gaussian on pretrained features did about as well as our own networks</mark>: most of the work was done by ImageNet, and we say so.</p>
          <p class="serif" data-reveal>Nothing here is a safety system. It is a careful comparison, and every number on this page can be traced to a notebook you can run yourself.</p>
          <p class="letter__sign" data-reveal>Ines, Emna, Khaled, Adrian, Hejer and Walid</p>
        </div>
      </section>

      <!-- CLOSING INVITATION -->
      <section class="invite wrap" aria-labelledby="invite-title">
        <h2 id="invite-title" class="invite__title" data-reveal>Your road photo, six opinions.</h2>
        <p class="serif invite__text" data-reveal>Upload any road photograph to the demo and see what each model flags, with its explanation on demand, or call the same six models from the API.</p>
