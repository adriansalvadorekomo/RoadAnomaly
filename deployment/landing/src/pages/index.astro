          <ul class="refs__credits serif" role="list">
            {photos.map((p) => (
              <li data-reveal><span><a class="text-link" href={p.source}>{p.title ?? pretty(p.frame)}</a>, {p.author}</span><span class="limits__value">{p.licence_url ? <a class="text-link" href={p.licence_url}>{p.licence}</a> : p.licence}</span></li>
            ))}
