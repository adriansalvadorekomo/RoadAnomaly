    {
      "dot": "cyan",
      "title": "CRISP-DM in this repository",
      "items": [
        "1 Business — objectives, ADR-0001 evaluation-only guardrail",
        "2 Data understanding — RoadAnomaly audit + normal-road source manifest",
        "3 Data preparation — tf.data, scene-grouped train/validation splits",
        "4 Modeling — A autoencoder, B resynthesis, C segmentation behind one Keras interface",
        "5 Evaluation — normal-road selection, held-out benchmarking, XAI gate",
        "6 Deployment — registry, FastAPI, Streamlit, Astro, GitOps"
      ]
    },
    {
      "dot": "amber",
      "title": "Promotion rule",
      "items": [
        "Selection uses normal-road validation only; RoadAnomaly never fits weights or thresholds",
        "Benchmark and XAI results are report-only; there is no edge from either to the registry",
        "The registry keeps all three candidate SavedModels + manifests and a selected alias",
        "Landing metrics render only from committed docs/experiments/ records"
      ]
    },
    {
      "dot": "rose",
      "title": "Status and gates",
      "items": [
        "Target architecture, not deployed",
        "XAI method undecided (G1): V1.8 cannot start until the method and justification are recorded",
        "No model, API, frontend, manifests, Argo CD application or Vercel project exists yet",
        "README results table stays empty until an experiment file exists"
      ]
